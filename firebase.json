{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "PlateUp",
        "supportEmail": "support@plateup.app",
        "authorizedRedirectUris": ["http://localhost"]
      }
    }
  },
  "apphosting": {
    "backendId": "plateup",
    "rootDir": "/",
    "ignore": ["node_modules", ".git", "firebase-debug.log"]
  }
}

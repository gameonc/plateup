rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: check if user owns this path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: validate user document creation (free plan only, no customer ID manipulation)
    function isValidUserCreate() {
      return request.resource.data.get('plan', 'free') == 'free'
        && request.resource.data.get('stripeCustomerId', '') == '';
    }

    // Helper: validate user document update (prevent privilege escalation on plan and stripeCustomerId)
    function isValidUserUpdate() {
      return request.resource.data.get('plan', 'free') == resource.data.get('plan', 'free')
        && request.resource.data.get('stripeCustomerId', '') == resource.data.get('stripeCustomerId', '');
    }

    // Users can only access their own data
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserCreate();
      allow update: if isOwner(userId) && isValidUserUpdate();
      allow delete: if isOwner(userId);
      
      // Recipes subcollection
      match /recipes/{recipeId} {
        allow read, write: if isOwner(userId);
      }
      
      // Meal plans subcollection
      match /mealPlans/{planId} {
        allow read, write: if isOwner(userId);
      }
      
      // Cooking log subcollection
      match /cookingLog/{logId} {
        allow read, write: if isOwner(userId);
      }

      // Shopping lists subcollections
      match /shoppingLists/{listId} {
        allow read, write: if isOwner(userId);
      }

      match /shoppingList/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
